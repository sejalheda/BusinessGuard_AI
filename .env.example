# ============================================
# BusinessGuard AI - Environment Configuration
# ============================================

# LLM Provider selection: "mock" (default, free & instant), "gemini", or "bedrock"
LLM_PROVIDER=mock

# Google Gemini API Key (required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Amazon Bedrock Configuration (required only if LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server & MCP Configuration
HOST=127.0.0.1
PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8001
DATABASE_PATH=data/businessguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
